# =====================================================================
# TEMPLATE BIẾN MÔI TRƯỜNG BÍ MẬT (.env)
# Đổi tên file này thành .env và điền thông tin thực tế
# =====================================================================

# Telegram Bot Credentials (Nhận tín hiệu và ảnh biểu đồ snapshot)
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_CHAT_ID=-1001234567890

# Optional: Binance API Credentials (Không bắt buộc vì dữ liệu nến M5 là hoàn toàn công khai)
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Optional Webhook
WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_url
